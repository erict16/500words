rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Diary body lives only under users/{uid}/days. Never on public or challenge rows.
    function noDiaryBody() {
      return !request.resource.data.keys().hasAny(['text', 'body', 'writing', 'entry', 'snippet']);
    }

    match /users/{uid} {
      allow read, write: if isSelf(uid);
      match /{document=**} {
        allow read, write: if isSelf(uid);
      }
    }

    match /challenges/{month}/entrants/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && noDiaryBody();
      allow delete: if isSelf(uid);
    }

    match /public/{month}/people/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid) && noDiaryBody();
      allow delete: if isSelf(uid);
    }
  }
}
